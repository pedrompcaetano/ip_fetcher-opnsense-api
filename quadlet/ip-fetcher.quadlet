[Unit]
Description=OPNsense IP Fetcher API Container
After=network-online.target

[Container]
Image=ghcr.io/pedrompcaetano/ip-fetcher:latest
ContainerName=opnsense-api
PublishPort=8000:8000
Memory=16m
ReadOnly=true
EnvironmentFile=/home/containers/.local/share/containers/storage/volumes/ip-fetcher_env/_data/.env

Network=systemd-public

SecurityLabelDisable=false
NoNewPrivileges=true
DropCapability=all
SeccompProfile=/usr/share/containers/seccomp.json

Label=traefik.enable=true
Label=traefik.http.services.ip-fetcher.loadbalancer.server.port=8000
Label=traefik.http.routers.ip-fetcher.rule=Host(`your-domain.com`) && PathPrefix(`/api/ips`) && Method(`GET`)
Label=traefik.http.routers.ip-fetcher.middlewares=secureHeaders@file,geoblock-pt@file,ip-fetcher-ratelimit@file
Label=traefik.http.routers.ip-fetcher.tls=true
Label=traefik.http.routers.ip-fetcher.tls.certresolver=letsencrypt
Label=traefik.http.routers.ip-fetcher.entrypoints=websecure

[Service]
Restart=always
TimeoutStartSec=90

[Install]
WantedBy=multi-user.target default.target

